{
  "name": "feed-the-kraken",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r --sort build",
    "test": "pnpm --filter @feed/server test && pnpm --filter @feed/client test",
    "typecheck": "pnpm --filter @feed/shared build && pnpm --filter @feed/server typecheck && pnpm --filter @feed/client typecheck"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "meshoptimizer": "~1.2.0",
    "pngjs": "^7.0.0",
    "typescript": "^6.0.3"
  },
  "packageManager": "pnpm@10.28.2"
}
