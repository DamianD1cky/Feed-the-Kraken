{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "framework": "vite",
    "installCommand": "pnpm install --frozen-lockfile --filter @feed/client...",
    "buildCommand": "pnpm --filter @feed/shared build && pnpm --filter @feed/client build",
    "outputDirectory": "packages/client/dist",
    "rewrites": [
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ]
}
