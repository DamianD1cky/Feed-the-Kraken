{
  "name": "@feed/server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @feed/shared build && tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@colyseus/schema": "^4.0.27",
    "@colyseus/tools": "^0.17.19",
    "@colyseus/ws-transport": "^0.17.13",
    "@feed/shared": "workspace:*",
    "better-sqlite3": "^12.11.1",
    "colyseus": "^0.17.10",
    "express": "^5.2.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.0",
    "tsx": "^4.22.5"
  }
}
