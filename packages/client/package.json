{
  "name": "@feed/client",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @feed/shared build && vite --host 0.0.0.0",
    "build": "tsc -p tsconfig.json && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm --filter @feed/server exec tsx --test ../client/src/*/*.test.ts",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "@colyseus/sdk": "^0.17.43",
    "@feed/shared": "workspace:*",
    "@phosphor-icons/react": "^2.1.10",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1",
    "three": "^0.186.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.0.3",
    "vite": "^8.1.3"
  }
}
